#include <stdio.h>
#include <stdlib.h>

void sequential()
{
    int n, start;

    printf("\nSequential File Allocation\n");
    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Allocated blocks are:\n");

    for (int i = 0; i < n; i++)
        printf("%d ", start + i);

    printf("\n");
}

void indexed()
{
    int n, indexBlock, blocks[50];

    printf("\nIndexed File Allocation\n");
    printf("Enter index block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("Index Block: %d\n", indexBlock);

    printf("Allocated blocks are:\n");

    for (int i = 0; i < n; i++)
        printf("%d ", blocks[i]);

    printf("\n");
}

void linked()
{
    int n, blocks[50];

    printf("\nLinked File Allocation\n");
    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("Linked blocks are:\n");

    for (int i = 0; i < n; i++)
    {
        if (i != n - 1)
            printf("%d -> ", blocks[i]);
        else
            printf("%d", blocks[i]);
    }

    printf("\n");
}

int main()
{
    sequential();
    indexed();
    linked();

    return 0;
}
