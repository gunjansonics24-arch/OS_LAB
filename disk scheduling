#include <stdio.h>
#include <stdlib.h>

void fcfs(int req[], int n, int head)
{
    int seek = 0;

    printf("\nFCFS Disk Scheduling\n");

    for (int i = 0; i < n; i++)
    {
        seek += abs(req[i] - head);
        head = req[i];
    }

    printf("Total Seek Time: %d\n", seek);
}

void sstf(int req[], int n, int head)
{
    int completed[50] = {0};
    int seek = 0;

    printf("\nSSTF Disk Scheduling\n");

    for (int i = 0; i < n; i++)
    {
        int min = 9999, index = -1;

        for (int j = 0; j < n; j++)
        {
            if (!completed[j] && abs(req[j] - head) < min)
            {
                min = abs(req[j] - head);
                index = j;
            }
        }

        seek += min;
        head = req[index];
        completed[index] = 1;
    }

    printf("Total Seek Time: %d\n", seek);
}

void scan(int req[], int n, int head, int disk_size)
{
    int seek = 0;
    int temp[50], count = 0;

    for (int i = 0; i < n; i++)
        temp[count++] = req[i];

    temp[count++] = 0;
    temp[count++] = disk_size - 1;

    for (int i = 0; i < count - 1; i++)
    {
        for (int j = 0; j < count - i - 1; j++)
        {
            if (temp[j] > temp[j + 1])
            {
                int t = temp[j];
                temp[j] = temp[j + 1];
                temp[j + 1] = t;
            }
        }
    }

    int pos;

    for (int i = 0; i < count; i++)
    {
        if (temp[i] >= head)
        {
            pos = i;
            break;
        }
    }

    for (int i = pos; i < count; i++)
    {
        seek += abs(temp[i] - head);
        head = temp[i];
    }

    for (int i = pos - 1; i >= 0; i--)
    {
        seek += abs(temp[i] - head);
        head = temp[i];
    }

    printf("\nSCAN Disk Scheduling\n");
    printf("Total Seek Time: %d\n", seek);
}

void clook(int req[], int n, int head)
{
    int seek = 0, temp[50];

    for (int i = 0; i < n; i++)
        temp[i] = req[i];

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (temp[j] > temp[j + 1])
            {
                int t = temp[j];
                temp[j] = temp[j + 1];
                temp[j + 1] = t;
            }
        }
    }

    int pos;

    for (int i = 0; i < n; i++)
    {
        if (temp[i] >= head)
        {
            pos = i;
            break;
        }
    }

    printf("\nC-LOOK Disk Scheduling\n");

    for (int i = pos; i < n; i++)
    {
        seek += abs(temp[i] - head);
        head = temp[i];
    }

    for (int i = 0; i < pos; i++)
    {
        seek += abs(temp[i] - head);
        head = temp[i];
    }

    printf("Total Seek Time: %d\n", seek);
}

int main()
{
    int n, head, disk_size;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    int req[n];

    printf("Enter request sequence:\n");

    for (int i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    fcfs(req, n, head);
    sstf(req, n, head);
    scan(req, n, head, disk_size);
    clook(req, n, head);

    return 0;
}
